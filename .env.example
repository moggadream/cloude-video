# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 GitHub에 올라가지 않아요)

# 접속 비밀번호 — 인터넷에 공개할 때는 꼭 설정하세요
APP_PASSWORD=

# 서버 주소 (텔레그램 알림의 링크에 사용). 예: https://video.example.com
PUBLIC_URL=
PORT=3000

# ffmpeg가 PATH에 등록되지 않았다면 실행 파일 위치를 적으세요 (ffprobe는 같은 폴더에서 자동으로 찾아요)
# FFMPEG_PATH=D:\ProgramFiles\ffmpeg\bin\ffmpeg.exe

# ── AI 분석·대본·글 (Claude) ── 없으면 예시 글로 만들어져요
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ── AI 나레이션 + 배경음악 (ElevenLabs) ── 없으면 자막만 + 임시 음악
ELEVENLABS_API_KEY=
# 한국어 목소리 ID (ElevenLabs Voice Library에서 골라 바꾸세요)
# ELEVENLABS_VOICE_ID=
# AI 작곡을 끄려면 off
# ELEVENLABS_MUSIC=on

# ── 텔레그램 알림 (선택) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 브라우저 푸시 키 (비워두면 처음 실행 때 자동 생성) ──
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
