# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 GitHub에 올라가지 않아요)

# ── 텔레그램 (지시·보고 통로) ─────────────────────────────
# 1) 텔레그램에서 @BotFather → /newbot → 받은 토큰을 아래에
TELEGRAM_BOT_TOKEN=
# 2) 앱을 켜고 내 봇에게 /start 를 보내면 채팅 ID를 알려줘요 → 아래에 적고 앱 다시 켜기
TELEGRAM_CHAT_ID=

# ── 구글 드라이브 (자료 받기·결과 저장) ──────────────────
# 구글 드라이브 데스크톱을 설치하면 드라이브가 내 컴퓨터 폴더(보통 G:)로 보여요.
# 그 안에 작업용 폴더를 하나 만들고 위치를 적으세요. 안에 "업로드", "결과" 폴더가 자동으로 생겨요.
DRIVE_DIR=G:\내 드라이브\콘텐츠자동화
# 드라이브 웹에서 "결과" 폴더를 열었을 때 주소창의 주소 (텔레그램 "드라이브 결과 폴더" 버튼)
DRIVE_RESULT_URL=

# ── AI ────────────────────────────────────────────────
# auto: API 키가 있으면 API, 없으면 내 컴퓨터의 Claude Code(구독), 둘 다 없으면 테스트 모드
AI_MODE=auto
# Claude Code를 쓸 때 모델 (비워두면 기본값. 사용량을 아끼려면 sonnet)
# CLAUDE_CODE_MODEL=sonnet
# claude 실행 파일을 못 찾을 때만 위치를 적으세요
# CLAUDE_CLI=C:\Users\내이름\.local\bin\claude.exe
# API 키로 쓸 때 (사용한 만큼 요금)
ANTHROPIC_API_KEY=

# ── 나레이션 음성 ──────────────────────────────────────
# auto: ElevenLabs 키가 있으면 그것, 없으면 무료 음성(edge-tts, Python 필요), 둘 다 없으면 자막만
# TTS_PROVIDER=auto
# 무료 음성: ko-KR-SunHiNeural(여) / ko-KR-InJoonNeural(남) / ko-KR-HyunsuMultilingualNeural(남)
# TTS_VOICE=ko-KR-SunHiNeural
# TTS_RATE=+8%
# 손떨림 보정 끄기: STABILIZE=off

# ── AI 나레이션 + 배경음악 (ElevenLabs, 선택) ─────────────
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MUSIC=on

# ── 기타 ──────────────────────────────────────────────
PORT=3000
# 밖에서도 확인 화면을 열 수 있게 공개할 때만 (https 주소, 비밀번호 필수)
PUBLIC_URL=
APP_PASSWORD=
# ffmpeg가 PATH에 없을 때만
# FFMPEG_PATH=D:\ProgramFiles\ffmpeg\bin\ffmpeg.exe
